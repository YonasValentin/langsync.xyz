# =============================================================================
# LangSync Environment Variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# PocketBase Configuration
# In production, this MUST be set — no localhost fallback.
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# PocketBase superuser credentials (server-side only)
POCKETBASE_ADMIN_EMAIL=admin@langsync.local
POCKETBASE_ADMIN_PASSWORD=your-admin-password

# Application URL (required in cloud mode for Stripe redirects)
# Set to your production URL, e.g. https://app.langsync.xyz
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Translation (set to "true" to enable AI-powered translations)
# When false/unset, all AI features are hidden and no API key is needed.
NEXT_PUBLIC_ENABLE_AI=false

# OpenAI Configuration (only needed when NEXT_PUBLIC_ENABLE_AI=true)
OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4-turbo

# Cloud Mode (set to "true" for managed cloud, omit for self-hosted)
# When false/unset, all plan limits are disabled and billing UI is hidden.
NEXT_PUBLIC_LANGSYNC_CLOUD=false

# Stripe (required when NEXT_PUBLIC_LANGSYNC_CLOUD=true)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_TEAM=price_...

# CORS (optional — restricts Access-Control-Allow-Origin for /api/v1)
# Comma-separated list of allowed origins. Defaults to "*" if not set.
# NEXT_PUBLIC_ALLOWED_ORIGINS=https://app.langsync.xyz

# Error Tracking (optional — Sentry integration)
# Set your Sentry DSN to enable error tracking and performance monitoring.
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ORG=your-org
# SENTRY_PROJECT=langsync
# SENTRY_AUTH_TOKEN=sntrys_...

# Redis (optional — for multi-instance rate limiting)
# When set, rate limiting uses Redis instead of in-memory.
# REDIS_URL=redis://localhost:6379
